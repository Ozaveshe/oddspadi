{
  "name": "oddspadi",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/run-next-build.cjs",
    "release:status": "node scripts/worktree-release.cjs status",
    "worktrees:sync": "node scripts/worktree-release.cjs sync",
    "release:verify": "npm run build && npm run typecheck && npm test && node scripts/verify-deploy-channel.cjs --release",
    "deploy:verify:manifest": "node scripts/verify-deploy-channel.cjs --manifest",
    "deploy:verify:local": "node scripts/verify-deploy-channel.cjs",
    "deploy:verify": "node scripts/verify-deploy-channel.cjs --online",
    "deploy:preview": "npm run deploy:verify && node scripts/run-netlify-deploy.cjs",
    "deploy:production": "npm run release:verify && node scripts/run-netlify-deploy.cjs --production",
    "doctor": "node scripts/oddspadi-doctor.cjs",
    "setup:admin-token": "node scripts/ensure-local-admin-token.cjs",
    "start": "next start",
    "test": "vitest run",
    "training:selection-preview": "vite-node --config scripts/vite-node.config.ts scripts/preview-economic-selection-policy.ts",
    "training:engine-preview": "vite-node --config scripts/vite-node.config.ts scripts/preview-economic-selection-policy.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "ops:health": "node scripts/site-health.mjs",
    "ops:warm": "node scripts/warm-caches.mjs",
    "ops:editorial": "node scripts/run-editorial-sweep.mjs",
    "ops:seed-feed": "node scripts/seed-community-posts.mjs",
    "results:backfill": "node --env-file-if-exists=.env.local scripts/backfill-public-results.mjs",
    "player-history:prepare": "vite-node --config scripts/vite-node.config.ts scripts/prepare-player-history.ts",
    "ops:calibration": "node --env-file-if-exists=.env.local scripts/promote-calibration.mjs",
    "ops:settle": "node --env-file-if-exists=.env.local scripts/settle-market-decisions.mjs",
    "ops:calibration-report": "node --env-file-if-exists=.env.local scripts/calibration-report.mjs",
    "ops:closing-lines": "node --env-file-if-exists=.env.local scripts/mark-closing-odds.mjs",
    "ops:outcomes": "node --env-file-if-exists=.env.local scripts/backfill-prediction-outcomes.mjs",
    "training:football-corpus": "vite-node --config scripts/vite-node.config.ts scripts/football-corpus-training.ts",
    "ops:prune-odds": "node --env-file-if-exists=.env.local scripts/prune-stale-odds.mjs",
    "ops:reconcile-ledger": "node --env-file-if-exists=.env.local scripts/reconcile-publication-ledger.mjs",
    "ops:loadtest": "node --env-file-if-exists=.env.local scripts/load-test-public-reads.mjs",
    "ops:reconcile-truth": "node --env-file-if-exists=.env.local scripts/reconcile-truth.mjs",
    "docs:state-matrix": "vite-node --config scripts/vite-node.config.ts scripts/generate-state-matrix-doc.ts",
    "gate:release": "node scripts/release-gate.mjs",
    "ops:publish": "node --env-file-if-exists=.env.local scripts/publish-picks.mjs",
    "ops:run-publisher": "vite-node --config scripts/vite-node.config.ts scripts/run-publisher.ts",
    "ops:expire-fixtures": "node --env-file-if-exists=.env.local scripts/expire-stale-fixtures.mjs",
    "ops:backfill-results": "node --env-file-if-exists=.env.local scripts/backfill-fixture-results.mjs",
    "check:migrations": "node --env-file-if-exists=.env.local scripts/check-migrations.mjs",
    "check:migrations:ledger": "node --env-file-if-exists=.env.local scripts/check-migrations.mjs --ledger",
    "ops:reconcile-lifecycles": "npx vite-node -c vitest.config.ts scripts/reconcile-fixture-lifecycles.ts",
    "docs:canonical-seed": "vite-node --config scripts/vite-node.config.ts scripts/generate-canonical-market-seed.ts",
    "ops:alerts": "node --env-file-if-exists=.env.local scripts/settlement-alerts.mjs"
  },
  "engines": {
    "node": "22.x"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.0",
    "@supabase/supabase-js": "^2.108.2",
    "fflate": "^0.8.2",
    "next": "^15.3.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "web-push": "^3.6.7"
  },
  "overrides": {
    "postcss": "^8.5.10"
  },
  "devDependencies": {
    "@netlify/functions": "5.3.0",
    "@netlify/plugin-nextjs": "^5.15.12",
    "@types/node": "^22.15.33",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@types/web-push": "^3.6.4",
    "typescript": "^5.8.3",
    "vite-node": "3.2.4",
    "vitest": "^3.2.4"
  }
}
